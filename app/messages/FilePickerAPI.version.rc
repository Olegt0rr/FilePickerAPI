// Resources of FilePickerAPI.messages.dll: the message table generated by
// mc (FilePickerAPI.rc) plus VERSIONINFO, so that Windows Installer
// replaces the DLL on upgrade by version. CI substitutes @FILEVERSION@
// (four comma-separated numbers) and @VERSION@ before running rc.
#include "FilePickerAPI.rc"

1 VERSIONINFO
FILEVERSION @FILEVERSION@
PRODUCTVERSION @FILEVERSION@
FILEOS 0x40004L
FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "File Picker API event messages"
            VALUE "FileVersion", "@VERSION@"
            VALUE "ProductName", "FilePickerAPI"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
