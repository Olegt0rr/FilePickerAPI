// Ресурсы FilePickerAPI.messages.dll: таблица сообщений, которую создаёт
// mc (FilePickerAPI.rc), и VERSIONINFO, чтобы Windows Installer заменял
// DLL при обновлении по версии. Перед запуском rc CI подставляет
// @FILEVERSION@ (четыре числа через запятую) и @VERSION@.
#include "FilePickerAPI.rc"

1 VERSIONINFO
FILEVERSION @FILEVERSION@
PRODUCTVERSION @FILEVERSION@
FILEOS 0x40004L
FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "File Picker API event messages"
            VALUE "FileVersion", "@VERSION@"
            VALUE "ProductName", "FilePickerAPI"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
